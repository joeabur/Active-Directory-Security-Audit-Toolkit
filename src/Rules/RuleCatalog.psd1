# Rule catalog. Every rule listed here is implemented by an audit module; tests enforce this in both directions.
@{
    SchemaVersion = '1.0'
    Rules         = @(
        @{
            Id           = 'ADSA-ACC-001'
            Title        = 'Stale enabled user account'
            Category     = 'Account lifecycle'
            Module       = 'AccountLifecycle'
            Severity     = 'Low'
            Confidence   = 'Medium'
            FindingType  = 'Hygiene'
            Description  = 'An enabled user account has not logged on within the configured inactivity threshold. This is hygiene evidence of a possibly unused account, not a confirmed vulnerability.'
            Remediation  = 'Confirm with the account owner. If unused, disable the account, document the change, and delete it after your retention period.'
            Limitations  = 'lastLogonTimestamp is replicated lazily (up to about 14 days of lag) and is not updated by every authentication type. Accounts used only via Kerberos service tickets or cached credentials may appear stale.'
            RequiredData = 'Users'
            Permissions  = 'Authenticated domain user (read of user attributes)'
        }
        @{
            Id           = 'ADSA-ACC-002'
            Title        = 'Inactive enabled computer account'
            Category     = 'Account lifecycle'
            Module       = 'AccountLifecycle'
            Severity     = 'Low'
            Confidence   = 'Medium'
            FindingType  = 'Hygiene'
            Description  = 'An enabled, non-domain-controller computer account shows no logon or machine password change within the inactivity threshold. This is hygiene evidence, not a confirmed vulnerability.'
            Remediation  = 'Verify the host is decommissioned, then disable and later delete the computer object.'
            Limitations  = 'Computers that are powered off for long periods, or that do not rotate machine passwords, can appear inactive while still in use.'
            RequiredData = 'Computers'
            Permissions  = 'Authenticated domain user'
        }
        @{
            Id           = 'ADSA-ACC-003'
            Title        = 'Enabled account with password that never expires'
            Category     = 'Account lifecycle'
            Module       = 'AccountLifecycle'
            Severity     = 'Medium'
            Confidence   = 'High'
            FindingType  = 'Misconfiguration'
            Description  = 'The DONT_EXPIRE_PASSWORD flag is set on an enabled user account, exempting it from password aging. This is a policy exception that needs a documented owner and compensating controls.'
            Remediation  = 'Remove the flag where possible. For genuine service accounts prefer group Managed Service Accounts; otherwise record a time-boxed exception with an owner.'
            Limitations  = 'The flag is a fact; whether it is acceptable depends on the account''s purpose, which this tool cannot determine.'
            RequiredData = 'Users'
            Permissions  = 'Authenticated domain user'
        }
        @{
            Id           = 'ADSA-ACC-004'
            Title        = 'Potentially orphaned account (manager disabled)'
            Category     = 'Account lifecycle'
            Module       = 'AccountLifecycle'
            Severity     = 'Low'
            Confidence   = 'Low'
            FindingType  = 'PotentialRisk'
            Description  = 'An enabled account lists a manager whose account is disabled, which can indicate the account lost its accountable owner.'
            Remediation  = 'Review ownership with HR or the application owner and assign a current manager or disable the account.'
            Limitations  = 'Heuristic only. Manager attributes are often stale or intentionally unset. Managers outside the collected user set cannot be evaluated.'
            RequiredData = 'Users'
            Permissions  = 'Authenticated domain user'
        }
        @{
            Id           = 'ADSA-ACC-005'
            Title        = 'Enabled account does not require a password'
            Category     = 'Account lifecycle'
            Module       = 'AccountLifecycle'
            Severity     = 'High'
            Confidence   = 'High'
            FindingType  = 'Misconfiguration'
            Description  = 'The PASSWD_NOTREQD flag is set on an enabled account, which can allow an empty password if domain policy does not otherwise prevent it.'
            Remediation  = 'Clear the flag and ensure the account has a strong password; investigate why it was set.'
            Limitations  = 'The flag permits, but does not prove, an empty password; the tool never tests passwords.'
            RequiredData = 'Users'
            Permissions  = 'Authenticated domain user'
        }
        @{
            Id           = 'ADSA-ACC-006'
            Title        = 'Kerberos pre-authentication disabled'
            Category     = 'Account lifecycle'
            Module       = 'AccountLifecycle'
            Severity     = 'High'
            Confidence   = 'High'
            FindingType  = 'Misconfiguration'
            Description  = 'The DONT_REQ_PREAUTH flag is set on an enabled account, so an unauthenticated party can request material derived from the account password for offline guessing.'
            Remediation  = 'Enable Kerberos pre-authentication unless a documented legacy dependency exists; ensure the password is long and random.'
            Limitations  = 'Configuration evidence only; the tool does not request or test any authentication material.'
            RequiredData = 'Users'
            Permissions  = 'Authenticated domain user'
        }
        @{
            Id           = 'ADSA-ACC-007'
            Title        = 'Weak Kerberos or password storage flags'
            Category     = 'Account lifecycle'
            Module       = 'AccountLifecycle'
            Severity     = 'Medium'
            Confidence   = 'High'
            FindingType  = 'Misconfiguration'
            Description  = 'An enabled account is restricted to DES (USE_DES_KEY_ONLY) or stores its password with reversible encryption (ENCRYPTED_TEXT_PWD_ALLOWED).'
            Remediation  = 'Clear the flags, reset the password through your normal process so stronger keys are generated, and retire clients that need DES.'
            Limitations  = 'Configuration evidence only. Domain-wide encryption type policy is not evaluated by this rule.'
            RequiredData = 'Users'
            Permissions  = 'Authenticated domain user'
        }
        @{
            Id           = 'ADSA-ACC-008'
            Title        = 'Enabled account that has never logged on'
            Category     = 'Account lifecycle'
            Module       = 'AccountLifecycle'
            Severity     = 'Low'
            Confidence   = 'Medium'
            FindingType  = 'Hygiene'
            Description  = 'An enabled account was created longer ago than the grace period and has no recorded logon. This is hygiene evidence, not a confirmed vulnerability.'
            Remediation  = 'Confirm whether the account is still needed; disable it if not.'
            Limitations  = 'Accounts used only through non-logon paths, or whose lastLogonTimestamp was never replicated to the queried DC, may appear never used.'
            RequiredData = 'Users'
            Permissions  = 'Authenticated domain user'
        }
        @{
            Id           = 'ADSA-SVC-001'
            Title        = 'Service account (SPN) with an old password'
            Category     = 'Account lifecycle'
            Module       = 'AccountLifecycle'
            Severity     = 'Medium'
            Confidence   = 'Medium'
            FindingType  = 'PotentialRisk'
            Description  = 'An enabled user account with service principal names has a password older than the configured limit. Service tickets for such accounts can be requested by any domain user and attacked offline, so password strength and age matter.'
            Remediation  = 'Migrate to group Managed Service Accounts, or rotate to a long random password and document the rotation schedule.'
            Limitations  = 'Password age is a proxy for exposure; the tool cannot measure password strength.'
            RequiredData = 'Users'
            Permissions  = 'Authenticated domain user'
        }
        @{
            Id           = 'ADSA-PRV-001'
            Title        = 'Privileged group membership exceeds the configured maximum'
            Category     = 'Privileged access'
            Module       = 'PrivilegedAccess'
            Severity     = 'Medium'
            Confidence   = 'High'
            FindingType  = 'PotentialRisk'
            Description  = 'The effective (nested) membership of a privileged group is larger than the configured maximum, widening the set of accounts that can administer the domain.'
            Remediation  = 'Review membership against least privilege; remove accounts that do not need standing privilege and prefer just-in-time elevation.'
            Limitations  = 'Counts are derived from collected group membership. Members that could not be resolved are not counted. Thresholds are organisational policy, not a universal standard.'
            RequiredData = 'Users, Groups'
            Permissions  = 'Authenticated domain user'
        }
        @{
            Id           = 'ADSA-PRV-002'
            Title        = 'Disabled or stale account in a privileged group'
            Category     = 'Privileged access'
            Module       = 'PrivilegedAccess'
            Severity     = 'High'
            Confidence   = 'Medium'
            FindingType  = 'Hygiene'
            Description  = 'A disabled or stale account remains in a privileged group (directly or through nesting). Dormant privileged accounts are attractive and rarely monitored.'
            Remediation  = 'Remove the account from privileged groups after confirming it is no longer needed.'
            Limitations  = 'Staleness is based on lastLogonTimestamp and shares its replication-lag caveat. Disabled accounts are reported at Low severity.'
            RequiredData = 'Users, Groups'
            Permissions  = 'Authenticated domain user'
        }
        @{
            Id           = 'ADSA-PRV-003'
            Title        = 'Privileged account with a password that never expires'
            Category     = 'Privileged access'
            Module       = 'PrivilegedAccess'
            Severity     = 'High'
            Confidence   = 'High'
            FindingType  = 'Misconfiguration'
            Description  = 'An enabled privileged account is exempt from password aging.'
            Remediation  = 'Remove the flag; use smart-card enforcement or a documented, owner-approved rotation process for break-glass accounts.'
            Limitations  = 'Documented break-glass accounts should be handled through configuration exceptions.'
            RequiredData = 'Users, Groups'
            Permissions  = 'Authenticated domain user'
        }
        @{
            Id           = 'ADSA-PRV-004'
            Title        = 'Privileged account with a service principal name'
            Category     = 'Privileged access'
            Module       = 'PrivilegedAccess'
            Severity     = 'High'
            Confidence   = 'High'
            FindingType  = 'Misconfiguration'
            Description  = 'An enabled privileged user account has SPNs, so its service ticket can be requested by any domain user and attacked offline.'
            Remediation  = 'Remove the SPN from the privileged account or run the service under a dedicated least-privilege account or gMSA.'
            Limitations  = 'Documented privileged service accounts should be handled through configuration exceptions with an owner and expiry.'
            RequiredData = 'Users, Groups'
            Permissions  = 'Authenticated domain user'
        }
        @{
            Id           = 'ADSA-PRV-005'
            Title        = 'Schema Admins group is populated'
            Category     = 'Privileged access'
            Module       = 'PrivilegedAccess'
            Severity     = 'Medium'
            Confidence   = 'High'
            FindingType  = 'Misconfiguration'
            Description  = 'Schema Admins should be empty except during schema changes. Standing membership grants forest-wide schema modification rights.'
            Remediation  = 'Remove all members and add accounts only for the duration of an approved schema change.'
            Limitations  = 'Only evaluated when the Schema Admins group exists in the queried domain (forest root).'
            RequiredData = 'Users, Groups'
            Permissions  = 'Authenticated domain user'
        }
        @{
            Id           = 'ADSA-PRV-006'
            Title        = 'Privileged account not marked sensitive and cannot be delegated'
            Category     = 'Privileged access'
            Module       = 'PrivilegedAccess'
            Severity     = 'Medium'
            Confidence   = 'High'
            FindingType  = 'Misconfiguration'
            Description  = 'An enabled privileged account lacks the NOT_DELEGATED flag and is not a member of Protected Users, so its credentials could be forwarded by a delegation-enabled service.'
            Remediation  = 'Enable ''Account is sensitive and cannot be delegated'' or place the account in the Protected Users group after testing.'
            Limitations  = 'Protected Users membership (direct or nested) is honoured only when that group is present in the collected Groups data; other delegation protections are not considered.'
            RequiredData = 'Users, Groups'
            Permissions  = 'Authenticated domain user'
        }
        @{
            Id           = 'ADSA-PRV-007'
            Title        = 'Group membership cycle reachable from a privileged group'
            Category     = 'Privileged access'
            Module       = 'PrivilegedAccess'
            Severity     = 'Low'
            Confidence   = 'High'
            FindingType  = 'Hygiene'
            Description  = 'Groups are nested in a cycle (A in B in ... in A). Cycles do not grant extra access but obscure effective membership and break naive audits.'
            Remediation  = 'Break the cycle by removing the redundant nesting.'
            Limitations  = 'Only cycles reachable from configured privileged groups are reported.'
            RequiredData = 'Groups'
            Permissions  = 'Authenticated domain user'
        }
        @{
            Id           = 'ADSA-PRV-008'
            Title        = 'Account with adminCount=1 outside privileged groups'
            Category     = 'Privileged access'
            Module       = 'PrivilegedAccess'
            Severity     = 'Low'
            Confidence   = 'Medium'
            FindingType  = 'Hygiene'
            Description  = 'The account still has adminCount=1 but is no longer in a configured privileged group. AdminSDHolder protection and disabled ACL inheritance can persist after removal from privileged groups.'
            Remediation  = 'Verify the account is not privileged, clear adminCount, and re-enable ACL inheritance on the object.'
            Limitations  = 'Protected groups missing from privilegedGroups in the configuration can make legitimate accounts appear orphaned. krbtgt is excluded.'
            RequiredData = 'Users, Groups'
            Permissions  = 'Authenticated domain user'
        }
        @{
            Id           = 'ADSA-DEL-001'
            Title        = 'Unconstrained delegation'
            Category     = 'Delegation'
            Module       = 'Delegation'
            Severity     = 'High'
            Confidence   = 'High'
            FindingType  = 'Misconfiguration'
            Description  = 'An enabled non-domain-controller account is trusted for unconstrained delegation, so it receives the Kerberos TGTs of users that authenticate to it.'
            Remediation  = 'Move to constrained or resource-based constrained delegation, or remove delegation. Protect privileged accounts from delegation.'
            Limitations  = 'Domain controllers are excluded because unconstrained delegation is expected on them.'
            RequiredData = 'Users, Computers'
            Permissions  = 'Authenticated domain user'
        }
        @{
            Id           = 'ADSA-DEL-002'
            Title        = 'Constrained delegation with protocol transition'
            Category     = 'Delegation'
            Module       = 'Delegation'
            Severity     = 'Medium'
            Confidence   = 'High'
            FindingType  = 'Misconfiguration'
            Description  = 'An enabled account can use protocol transition (TRUSTED_TO_AUTH_FOR_DELEGATION), allowing it to obtain service tickets for users without those users authenticating via Kerberos.'
            Remediation  = 'Use Kerberos-only constrained delegation where possible and review the delegation targets.'
            Limitations  = 'Whether the configuration is acceptable depends on the targets and the application design.'
            RequiredData = 'Users, Computers'
            Permissions  = 'Authenticated domain user'
        }
        @{
            Id           = 'ADSA-DEL-003'
            Title        = 'Constrained delegation to a domain controller service'
            Category     = 'Delegation'
            Module       = 'Delegation'
            Severity     = 'High'
            Confidence   = 'High'
            FindingType  = 'Misconfiguration'
            Description  = 'An account is allowed to delegate to a sensitive service (for example ldap or cifs) on a domain controller.'
            Remediation  = 'Remove delegation to domain controller services unless there is a documented, reviewed requirement.'
            Limitations  = 'Only service classes ldap, cifs, host, gc, rpcss and wsman are considered. Host matching uses collected DC names.'
            RequiredData = 'Users, Computers, DomainControllers'
            Permissions  = 'Authenticated domain user'
        }
        @{
            Id           = 'ADSA-DEL-004'
            Title        = 'Resource-based constrained delegation configured on a domain controller'
            Category     = 'Delegation'
            Module       = 'Delegation'
            Severity     = 'High'
            Confidence   = 'Medium'
            FindingType  = 'PotentialRisk'
            Description  = 'A domain controller computer object allows other principals to act on behalf of users (msDS-AllowedToActOnBehalfOfOtherIdentity). Anyone who controls an allowed principal can impersonate users to that DC.'
            Remediation  = 'Clear the attribute unless a documented, reviewed requirement exists.'
            Limitations  = 'Only domain controller computer objects are inspected. The allowed principals are listed but not resolved to privilege level.'
            RequiredData = 'Computers'
            Permissions  = 'Authenticated domain user'
        }
        @{
            Id           = 'ADSA-ACL-001'
            Title        = 'Non-privileged principal holds high-risk rights on a sensitive object'
            Category     = 'Access control'
            Module       = 'Acl'
            Severity     = 'High'
            Confidence   = 'High'
            FindingType  = 'Misconfiguration'
            Description  = 'A principal that is not an expected administrator holds GenericAll, WriteDacl, WriteOwner, GenericWrite, write-all-properties, all-extended-rights, password reset, group membership write or GPO link write rights on a sensitive object.'
            Remediation  = 'Review the ACE with the object owner. Remove it if unnecessary, or document and monitor it. Do not modify ACLs without change control.'
            Limitations  = 'Selective coverage: domain root, AdminSDHolder, privileged groups, Domain Controllers OU, and domain controller objects. Group membership of the principal is not expanded. This is not an exhaustive attack-path analysis.'
            RequiredData = 'Acls'
            Permissions  = 'Authenticated domain user (read DACL)'
        }
        @{
            Id           = 'ADSA-ACL-002'
            Title        = 'Directory replication rights granted to a non-default principal'
            Category     = 'Access control'
            Module       = 'Acl'
            Severity     = 'Critical'
            Confidence   = 'High'
            FindingType  = 'Misconfiguration'
            Description  = 'A principal other than the expected administrators and domain controllers holds both DS-Replication-Get-Changes and DS-Replication-Get-Changes-All on the domain root, which allows it to replicate secrets from the directory (DCSync-capable).'
            Remediation  = 'Remove the rights unless required by a documented synchronisation product, then restrict and monitor the account that uses them.'
            Limitations  = 'Group membership of the principal is not expanded. Legitimate synchronisation accounts should be recorded as exceptions.'
            RequiredData = 'Acls'
            Permissions  = 'Authenticated domain user (read DACL)'
        }
        @{
            Id           = 'ADSA-ACL-003'
            Title        = 'Sensitive object owned by a non-privileged principal'
            Category     = 'Access control'
            Module       = 'Acl'
            Severity     = 'High'
            Confidence   = 'High'
            FindingType  = 'Misconfiguration'
            Description  = 'The owner of a sensitive object is not an expected administrator. Owners can always rewrite the object''s DACL.'
            Remediation  = 'Review and, under change control, restore ownership to an administrative group.'
            Limitations  = 'Selective coverage as for ADSA-ACL-001.'
            RequiredData = 'Acls'
            Permissions  = 'Authenticated domain user (read owner)'
        }
        @{
            Id           = 'ADSA-ACL-004'
            Title        = 'Non-privileged principal can modify a Group Policy Object'
            Category     = 'Access control'
            Module       = 'Acl'
            Severity     = 'High'
            Confidence   = 'High'
            FindingType  = 'Misconfiguration'
            Description  = 'A principal that is not an expected administrator has high-risk write rights on a GPO container. GPO edit rights can lead to code execution on every computer the GPO applies to.'
            Remediation  = 'Remove unnecessary edit rights or restrict them to dedicated policy administrators under change control.'
            Limitations  = 'Only the GPO container object ACL is inspected, not the SYSVOL file ACL. Group Policy Creator Owners members are reported.'
            RequiredData = 'Gpos'
            Permissions  = 'Authenticated domain user (read DACL)'
        }
        @{
            Id           = 'ADSA-POL-001'
            Title        = 'Minimum password length below baseline'
            Category     = 'Authentication policy'
            Module       = 'AuthenticationPolicy'
            Severity     = 'Medium'
            Confidence   = 'High'
            FindingType  = 'Misconfiguration'
            Description  = 'The default domain password policy requires fewer characters than the configured baseline.'
            Remediation  = 'Raise the minimum length in the default domain policy, or apply a fine-grained policy where appropriate.'
            Limitations  = 'Only the default domain policy is evaluated. Fine-grained password policies can override it for specific users and groups.'
            RequiredData = 'PasswordPolicy'
            Permissions  = 'Authenticated domain user'
        }
        @{
            Id           = 'ADSA-POL-002'
            Title        = 'Password complexity not required'
            Category     = 'Authentication policy'
            Module       = 'AuthenticationPolicy'
            Severity     = 'Medium'
            Confidence   = 'High'
            FindingType  = 'Misconfiguration'
            Description  = 'The default domain password policy does not require complexity, while the configured baseline does.'
            Remediation  = 'Enable password complexity or adopt a long-passphrase policy and update the baseline configuration.'
            Limitations  = 'Only the default domain policy is evaluated. Modern guidance favours length over complexity; set passwordPolicy.complexityRequired accordingly.'
            RequiredData = 'PasswordPolicy'
            Permissions  = 'Authenticated domain user'
        }
        @{
            Id           = 'ADSA-POL-003'
            Title        = 'Password history below baseline'
            Category     = 'Authentication policy'
            Module       = 'AuthenticationPolicy'
            Severity     = 'Low'
            Confidence   = 'High'
            FindingType  = 'Misconfiguration'
            Description  = 'The default domain password policy remembers fewer passwords than the configured baseline, making reuse easier.'
            Remediation  = 'Increase the enforced password history.'
            Limitations  = 'Only the default domain policy is evaluated.'
            RequiredData = 'PasswordPolicy'
            Permissions  = 'Authenticated domain user'
        }
        @{
            Id           = 'ADSA-POL-004'
            Title        = 'Account lockout disabled or threshold too high'
            Category     = 'Authentication policy'
            Module       = 'AuthenticationPolicy'
            Severity     = 'Medium'
            Confidence   = 'High'
            FindingType  = 'Misconfiguration'
            Description  = 'The default domain policy has no account lockout, or a lockout threshold above the configured maximum, which weakens protection against online password guessing.'
            Remediation  = 'Set a lockout threshold within the baseline and monitor lockout events.'
            Limitations  = 'Only the default domain policy is evaluated. Lockout can also be used for denial of service; the baseline is organisational policy.'
            RequiredData = 'PasswordPolicy'
            Permissions  = 'Authenticated domain user'
        }
        @{
            Id           = 'ADSA-POL-005'
            Title        = 'Account lockout duration below baseline'
            Category     = 'Authentication policy'
            Module       = 'AuthenticationPolicy'
            Severity     = 'Low'
            Confidence   = 'High'
            FindingType  = 'Misconfiguration'
            Description  = 'Accounts unlock after less time than the configured minimum, reducing the cost of repeated online guessing.'
            Remediation  = 'Increase the lockout duration to at least the baseline.'
            Limitations  = 'Only the default domain policy is evaluated. A duration of 0 (administrator unlock) is treated as compliant.'
            RequiredData = 'PasswordPolicy'
            Permissions  = 'Authenticated domain user'
        }
        @{
            Id           = 'ADSA-POL-006'
            Title        = 'Reversible password encryption enabled in domain policy'
            Category     = 'Authentication policy'
            Module       = 'AuthenticationPolicy'
            Severity     = 'High'
            Confidence   = 'High'
            FindingType  = 'Misconfiguration'
            Description  = 'The default domain policy stores passwords using reversible encryption, which is equivalent to storing them in clear text for anyone with directory access.'
            Remediation  = 'Disable the policy and reset affected passwords through your normal process.'
            Limitations  = 'Only the default domain policy is evaluated.'
            RequiredData = 'PasswordPolicy'
            Permissions  = 'Authenticated domain user'
        }
        @{
            Id           = 'ADSA-KRB-001'
            Title        = 'krbtgt password is old'
            Category     = 'Authentication policy'
            Module       = 'AuthenticationPolicy'
            Severity     = 'High'
            Confidence   = 'High'
            FindingType  = 'Misconfiguration'
            Description  = 'The krbtgt account password has not been rotated within the configured limit. A stolen krbtgt key allows forged Kerberos tickets until the password is changed twice.'
            Remediation  = 'Rotate krbtgt following Microsoft''s documented two-step procedure during a maintenance window.'
            Limitations  = 'Based on pwdLastSet of the queried DC''s copy. Read-only domain controller krbtgt_* accounts are not evaluated.'
            RequiredData = 'Users'
            Permissions  = 'Authenticated domain user'
        }
        @{
            Id           = 'ADSA-LDAP-001'
            Title        = 'LDAP signing not required on domain controller'
            Category     = 'Authentication policy'
            Module       = 'AuthenticationPolicy'
            Severity     = 'High'
            Confidence   = 'High'
            FindingType  = 'Misconfiguration'
            Description  = 'The domain controller does not require LDAP signing (LDAPServerIntegrity is not 2), so unsigned binds can be relayed or tampered with.'
            Remediation  = 'Require LDAP signing via Group Policy after auditing clients with event ID 2889.'
            Limitations  = 'Reads the registry value on each DC. A GPO may set the effective value elsewhere; an unset value is reported with Medium confidence and its OS default is not asserted for Windows Server 2025.'
            RequiredData = 'DcHosts'
            Permissions  = 'Remote registry or WinRM read access to each domain controller'
        }
        @{
            Id           = 'ADSA-LDAP-002'
            Title        = 'LDAP channel binding not enforced on domain controller'
            Category     = 'Authentication policy'
            Module       = 'AuthenticationPolicy'
            Severity     = 'Medium'
            Confidence   = 'High'
            FindingType  = 'Misconfiguration'
            Description  = 'LdapEnforceChannelBinding is not set to 2 (always), so LDAP over TLS sessions can be relayed.'
            Remediation  = 'Enable channel binding enforcement after auditing clients with event ID 3039/3040.'
            Limitations  = 'Reads the registry value on each DC. Unset values are reported with Medium confidence.'
            RequiredData = 'DcHosts'
            Permissions  = 'Remote registry or WinRM read access to each domain controller'
        }
        @{
            Id           = 'ADSA-DC-001'
            Title        = 'Print Spooler service running on domain controller'
            Category     = 'Authentication policy'
            Module       = 'AuthenticationPolicy'
            Severity     = 'High'
            Confidence   = 'High'
            FindingType  = 'Misconfiguration'
            Description  = 'The Print Spooler service is running on a domain controller, enlarging its attack surface.'
            Remediation  = 'Disable the Print Spooler service on domain controllers unless there is a documented need.'
            Limitations  = 'Reports the service state at collection time only.'
            RequiredData = 'DcHosts'
            Permissions  = 'WinRM read access to each domain controller'
        }
        @{
            Id           = 'ADSA-AUD-001'
            Title        = 'Required advanced audit subcategory not fully enabled'
            Category     = 'Authentication policy'
            Module       = 'AuthenticationPolicy'
            Severity     = 'Medium'
            Confidence   = 'Medium'
            FindingType  = 'Misconfiguration'
            Description  = 'One or more required advanced audit policy subcategories do not audit the configured success or failure events on a domain controller.'
            Remediation  = 'Configure the subcategories via Group Policy so security-relevant events are recorded.'
            Limitations  = 'Parses English auditpol output only; other languages are reported NOT_ASSESSED. Reads local effective policy and requires administrator rights on the DC.'
            RequiredData = 'DcHosts'
            Permissions  = 'Local administrator (or equivalent audit privilege) on each domain controller'
        }
        @{
            Id           = 'ADSA-AUD-002'
            Title        = 'Security event log capacity below baseline'
            Category     = 'Authentication policy'
            Module       = 'AuthenticationPolicy'
            Severity     = 'Medium'
            Confidence   = 'High'
            FindingType  = 'Misconfiguration'
            Description  = 'The Security log maximum size is below the configured minimum, so events may be overwritten before they are collected.'
            Remediation  = 'Increase the maximum size and forward events to a central collector.'
            Limitations  = 'Checks configured size only, not event forwarding or actual retention time.'
            RequiredData = 'DcHosts'
            Permissions  = 'Event Log Readers or equivalent on each domain controller'
        }
        @{
            Id           = 'ADSA-GPO-001'
            Title        = 'Weak LAN Manager authentication level in GPO'
            Category     = 'Group Policy'
            Module       = 'GroupPolicy'
            Severity     = 'Medium'
            Confidence   = 'Medium'
            FindingType  = 'Misconfiguration'
            Description  = 'A GPO linked to the domain root or Domain Controllers OU sets LmCompatibilityLevel below 5, permitting weaker NTLM variants.'
            Remediation  = 'Set ''Send NTLMv2 response only. Refuse LM and NTLM'' after validating client compatibility.'
            Limitations  = 'GPO precedence and RSOP are not modelled; conflicting GPOs are reported at Low confidence. If no GPO defines the setting the rule is NOT_ASSESSED.'
            RequiredData = 'Gpos'
            Permissions  = 'Read access to SYSVOL'
        }
        @{
            Id           = 'ADSA-GPO-002'
            Title        = 'SMB server signing not required in GPO'
